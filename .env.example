# ==============================================================================
# MINT — AUTONOMOUS DIGITAL VENTURE ENGINE
# Master Unified Environment Configuration Template (.env.example)
# Copy this to .env and configure your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
HOST=127.0.0.1
FLASK_SECRET_KEY=mint-venture-secret-key-production-ready
OAUTHLIB_INSECURE_TRANSPORT=1

# ------------------------------------------------------------------------------
# 2. AI TEXT GENERATION & DIGITAL PRODUCT ENGINE (Chat, Guides, PDFs)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. AI IMAGE GENERATION — CLOUDFLARE WORKERS AI (FLUX.1 Schnell)
# Free allocation: 10,000 neurons/day.
# ------------------------------------------------------------------------------
IMAGE_PROVIDER=cloudflare_workers_ai
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. PUBLIC HTTPS MEDIA HOSTING — CLOUDINARY
# Meta requires public HTTPS media URLs for Instagram publishing.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_MEDIA_BASE_URL=

# ------------------------------------------------------------------------------
# 5. META / INSTAGRAM GRAPH API INTEGRATION
# ------------------------------------------------------------------------------
INSTAGRAM_LOGIN_METHOD=facebook_login
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRANTED_SCOPES=instagram_business_basic,instagram_business_content_publish

# ------------------------------------------------------------------------------
# 6. YOUTUBE DATA API v3 (Google OAuth 2.0 Web Flow)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_SECRET_JSON=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5000/oauth2callback

# ------------------------------------------------------------------------------
# 7. GUMROAD DIGITAL STORE INTEGRATION
# ------------------------------------------------------------------------------
GUMROAD_ACCESS_TOKEN=
GUMROAD_AUTO_PUBLISH=1
